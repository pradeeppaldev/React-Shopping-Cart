# VIBECART STUDIO // ARCHIVE - Production Environment Configuration

# Optional external API Base URL (if connecting to a headless backend)
# If omitted or unavailable, the application gracefully uses the built-in local catalog dataset
REACT_APP_API_URL=https://api.vibecart.studio/v1

# Brand and Environment Settings
REACT_APP_BRAND_NAME="VIBECART STUDIO"
REACT_APP_ENVIRONMENT=production

# Feature Flags
REACT_APP_ENABLE_GAMIFICATION=true
REACT_APP_ENABLE_SPIN_WHEEL=true
REACT_APP_ENABLE_NOTIFICATIONS=true
